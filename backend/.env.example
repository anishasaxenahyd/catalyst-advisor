# Which LLMProvider implementation is active. Default: groq (api.groq.com),
# the only production vendor provider in this POC.
# If GROQ_API_KEY is not set, the factory logs a warning and falls back to
# MockLLMProvider for the life of the process (the app always boots).
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# If GROQ_API_KEY IS set but Groq fails at request time (timeout, outage,
# malformed output — after GroqProvider's own retries are exhausted), the
# factory wraps it in FallbackLLMProvider so each request degrades to
# MockLLMProvider individually rather than the request failing outright.
# Set to "false" to disable this and let request-time failures raise instead.
LLM_FALLBACK_TO_MOCK=true

# Set LLM_PROVIDER=mock to force the deterministic mock provider (e.g. for
# local development without an API key, or CI).

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGIN=http://localhost:5173
